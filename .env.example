# =====================================================================
# LOCAL DEVELOPMENT SECRETS — docker compose reads this file as .env
#
#   1. cp .env.example .env
#   2. Fill in the values below
#   3. docker compose up --build
#
# .env is listed in .gitignore — NEVER commit real credentials.
# =====================================================================

# --- Google SSO -------------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → your
# OAuth 2.0 Client ID ("Web application" type).
#
# Console settings that must match:
#   Authorized JavaScript origins:  http://localhost:8080
#   Authorized redirect URIs:       http://localhost:8080/auth/google/callback
#
# Leave both empty to run WITHOUT sign-in (anonymous shortening only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session JWT cookies. Generate a strong one with:
#   openssl rand -hex 32
# The default "insecure-dev-secret" lets anyone forge sessions —
# fine for localhost, never fine anywhere else.
SESSION_SECRET=insecure-dev-secret

# The public URL of this app. Used to build the OAuth redirect URI,
# so it must equal the origin you registered in the Google console.
PUBLIC_BASE_URL=http://localhost:8080
